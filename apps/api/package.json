{
  "name": "@supermarket/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:ts": "node scripts/clean-dist-src.js && tsc -p tsconfig.json",
    "build": "npm run build:ts && node scripts/package-lambda.js",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:audit": "tsx tests/audit-log.test.ts && tsx tests/audit-actor-context.test.ts",
    "test:shopping": "npm run build:ts && tsx --test tests/shopping-update-product.test.ts tests/shopping-product-mutations.test.ts",
    "test:storefront": "npm run build:ts && tsx --test tests/storefront-order-lifecycle.test.ts tests/storefront-payment.test.ts tests/payment-recovery.test.ts tests/storefront-reads.test.ts",
    "package:lambda": "npm run build:ts && node scripts/package-lambda.js",
    "db:init": "tsx src/scripts/create-table.ts",
    "db:reset-table": "tsx src/scripts/reset-table.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reseed": "tsx src/scripts/reseed.ts",
    "db:backfill-products": "tsx src/scripts/backfill-products.ts",
    "db:backfill-product-category-index": "tsx src/scripts/backfill-product-category-index.ts",
    "db:remove-checkout-reservation-expiry": "tsx src/scripts/remove-checkout-reservation-expiry.ts",
    "db:remove-reserved-stock": "tsx src/scripts/remove-reserved-stock.ts",
    "db:remove-awaiting-payment-order-id": "tsx src/scripts/remove-awaiting-payment-order-id.ts",
    "db:update-product-images": "tsx src/scripts/update-product-images.ts",
    "db:localize": "tsx src/scripts/localize-products.ts",
    "check:architecture": "node scripts/check-architecture.js",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:boundaries": "npm run build:ts && tsx --test tests/http-boundaries.test.ts",
    "test:integration": "npm run build:ts && node --test tests/dynamodb.integration.test.mjs",
    "typecheck:tests": "npm run build:ts && tsc -p tsconfig.tests.json",
    "verify": "npm run check:architecture && npm run test:architecture && npm run typecheck && npm run typecheck:tests && npm run test:shopping && npm run test:storefront && npm run test:audit && npm run test:boundaries && npm run test:remaining && npm run test:domain && npm run test:workflows",
    "test:remaining": "npm run build:ts && tsx --test tests/remaining-architecture.test.ts",
    "test:domain": "npm run build:ts && tsx --test tests/rich-domain-entities.test.ts",
    "test:workflows": "npm run build:ts && tsx --test tests/workflow-orchestration.test.ts tests/notification-workflows.test.ts tests/email-workflows.test.ts tests/business-workflows.test.ts"
  },
  "dependencies": {
    "@aws-crypto/client-node": "^5.0.2",
    "@aws-sdk/client-cognito-identity-provider": "3.1103.0",
    "@aws-sdk/client-dynamodb": "3.1095.0",
    "@aws-sdk/client-eventbridge": "3.1095.0",
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/client-scheduler": "3.1095.0",
    "@aws-sdk/client-sesv2": "3.1095.0",
    "@aws-sdk/client-sns": "3.1095.0",
    "@aws-sdk/client-sqs": "3.1095.0",
    "@aws-sdk/core": "3.977.6",
    "@aws-sdk/lib-dynamodb": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@aws-sdk/util-dynamodb": "3.996.7",
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "^11.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "aws-jwt-verify": "^5.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.5"
  },
  "overrides": {
    "@aws-sdk/core": "3.977.6",
    "@aws-sdk/credential-provider-node": "3.972.78",
    "@aws-sdk/types": "3.974.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
